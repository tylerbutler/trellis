---
import { Code } from "@astrojs/starlight/components";
import Base from "../layouts/Base.astro";
import { TRELLIS_VERSION } from "../lib/version";

const installCmd =
  "curl --proto '=https' --tlsv1.2 -LsSf https://github.com/tylerbutler/trellis/releases/latest/download/trellis-gleam-installer.sh | sh";

const miseCmd = `mise use "github:tylerbutler/trellis@${TRELLIS_VERSION}"`;

const configSample = `# The table's presence marks the workspace root.
# Every key is optional. Omit members to auto-discover from git.
[tools.trellis]
members = ["packages/*", "examples/*"]
# Exclusions are scoped by task. \`@release\` covers changelog,
# versioning, tagging, publishing, and release CI.
exclude = { docs = ["examples/*"], "@release" = ["examples/*"] }

[tools.trellis.tasks.lint]
command = "gleam run -m glinter"

[tools.trellis.publish]
exact_tag_format = "{name}-v{version}"`;
---

<Base
  title="Trellis: a workspace CLI for Gleam monorepos"
  description="Run builds and tests across Gleam packages. Manage changelogs, versions, and publishing using the dependencies in gleam.toml."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <h1>
          Workspace tools for Gleam monorepos.
          <em>Derived from gleam.toml.</em>
        </h1>
        <p class="lead">
          Gleam builds, tests, and publishes one package at a time. Trellis runs
          those commands across your packages and manages their changelogs and versions.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/">Read the docs</a>
          <a class="btn btn-ghost" href="#install">Install</a>
        </div>
        <div class="cmdline hero-install">
          <code><span class="prompt">$</span>{installCmd}</code>
          <button class="copy-btn" type="button" aria-live="polite" data-copy={installCmd}>Copy</button>
        </div>
      </div>
      <figure class="term hero-term">
        <figcaption class="term-bar"><span class="prompt">$</span>trellis graph</figcaption>
        <pre class="term-out"><code><span class="name">lat_core</span> <span class="dim">(1.2.0)</span>
<span class="name">lat_mid</span> <span class="dim">(0.5.0)</span>
<span class="dim">  └─</span> lat_core
<span class="name">lat_cli</span> <span class="dim">(0.3.1)</span>
<span class="dim">  ├─</span> lat_core
<span class="dim">  └─</span> lat_mid
<span class="name">package_a</span> <span class="dim">(0.0.0)</span>
<span class="dim">  └─</span> lat_cli</code></pre>
        <figcaption class="term-note">
          Output from the <a href="https://github.com/tylerbutler/trellis/tree/main/tests/fixtures/basic">example workspace</a>.{" "}
          Trellis computes the graph from path dependencies.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ THE GLUE ============ -->
  <section class="glue">
    <div class="shell">
      <div class="section-head">
        <h2>The glue this replaces.</h2>
        <p>
          The <a href="https://github.com/tylerbutler/trellis/blob/main/docs/DESIGN.md#inventory-of-manual-wiring-in-lattice">lattice inventory</a>{" "}
          records the bash loops, YAML blocks, and duplicated configuration
          below. Each row is workspace information that was maintained by hand.
        </p>
      </div>
      <div class="ledger-scroll">
        <table class="ledger">
          <thead>
            <tr>
              <th scope="col">File</th>
              <th scope="col">What's maintained by hand</th>
              <th scope="col">What can drift</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>justfile</code></td>
              <td>The package list, in topological order, as a space-separated string</td>
              <td>A new package is silently excluded from every recipe</td>
            </tr>
            <tr>
              <td><code>justfile</code></td>
              <td>~15 near-identical <code>for pkg in …</code> bash loops</td>
              <td>Copy-paste drift between recipes; strictly serial execution</td>
            </tr>
            <tr>
              <td><code>.changie.yaml</code></td>
              <td>One config block per package: label, key, changelog path, version regex</td>
              <td>A forgotten block means a package can't be versioned or released</td>
            </tr>
            <tr>
              <td><code>publish.yml</code></td>
              <td>A hand-written copy of the path dependency graph</td>
              <td>Nothing verifies it when a package gains a dependency</td>
            </tr>
            <tr>
              <td><code>release.yml</code></td>
              <td>25 lines of inline <code>sed</code>/<code>grep</code> patching locked versions</td>
              <td>Version edits depend on regexes embedded in CI YAML</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="ledger-coda">
        Trellis derives the information behind each row from{" "}
        <code>gleam.toml</code>, a file format the ecosystem already uses.
      </p>
    </div>
  </section>

  <!-- ============ DERIVED, NOT DECLARED ============ -->
  <section class="derived">
    <div class="shell">
      <blockquote class="doctrine">
        <p>
          Configure nothing that can be derived.<br />
          Verify anything that must be duplicated.
        </p>
      </blockquote>
      <div class="derived-grid">
        <div class="config">
          <Code lang="toml" title="gleam.toml" code={configSample} wrap />
        </div>
        <div class="derived-list">
          <h3>From that, trellis computes:</h3>
          <ul>
            <li>
              <strong>Package discovery and dependency order.</strong> Trellis
              includes directories that match your member patterns and contain
              a package manifest, subject to membership and task exclusions.
            </li>
            <li>
              <strong>Change impact.</strong> <code>--since origin/main</code>{" "}
              selects packages with changed files. Add{" "}
              <code>--with-dependents</code> to include packages that depend on them.
            </li>
            <li>
              <strong>Publish order and path-dep rewrites.</strong> Dependencies
              publish first, and path references become Hex versions
              automatically.
            </li>
            <li>
              <strong>Package tags and configuration checks.</strong>{" "}
              <code>trellis doctor</code> reports problems and exits non-zero on errors.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OPINIONATED, BUT MODULAR ============ -->
  <section class="adopt">
    <div class="shell">
      <div class="section-head">
        <h2>Opinionated, but modular.</h2>
        <p>
          Trellis records each change as a TOML fragment, derives version bumps
          from fragment kinds, and tags each release per package. You choose
          when to tag and when to publish. Start with task
          running and keep your existing changelog tool and CI.
          Add trellis's changelog, versioning, or publishing commands when you need them.
        </p>
      </div>
      <ol class="adopt-paths">
        <li>
          <h3>Just the task runner</h3>
          <p>
            <code>run</code>, <code>exec</code>, <code>list</code>, and{" "}
            <code>graph</code> need no configuration at all, because members
            are auto-discovered from git.
          </p>
        </li>
        <li>
          <h3>Add changelogs and versioning</h3>
          <p>
            Fragments, <code>version plan</code>, and <code>version apply</code>{" "}
            manage version bumps and changelogs locally or in your existing CI.
          </p>
        </li>
        <li>
          <h3>Add publishing</h3>
          <p>
            <code>tag</code> records releases; <code>publish</code> uploads packages
            to Hex in dependency order.
          </p>
        </li>
        <li>
          <h3>The full pipeline</h3>
          <p>
            <code>ci</code>, <code>changelog check</code>, and{" "}
            <code>release pr</code> generate matrices, check changelog coverage,
            and prepare release pull requests for GitHub Actions.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ PACKAGE EXCLUSIONS ============ -->
  <section class="exclusions">
    <div class="shell exclusions-grid">
      <div class="section-head">
        <h2>One workspace. Different task sets.</h2>
        <p>
          Examples, benchmarks, and internal tools can remain workspace members
          for builds, tests, and graphing without needing generated docs or a
          release on Hex.
        </p>
        <p>
          <code>exclude</code> gives each built-in or custom task its own
          member-path globs. The reserved <code>@release</code> key covers
          changelogs, versioning, tags, publishing, and release CI.
        </p>
        <a href="/docs/configuration/#package-exclusions">Configure package exclusions →</a>
      </div>

      <div class="exclusion-proof">
        <div class="exclusion-ledger-scroll">
          <table class="exclusion-ledger">
            <thead>
              <tr>
                <th scope="col">Package path</th>
                <th scope="col">build / test</th>
                <th scope="col">docs</th>
                <th scope="col">release</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>packages/*</code></td>
                <td><span class="state state-included">included</span></td>
                <td><span class="state state-included">included</span></td>
                <td><span class="state state-included">included</span></td>
              </tr>
              <tr>
                <td><code>examples/*</code></td>
                <td><span class="state state-included">included</span></td>
                <td><span class="state state-excluded">excluded</span></td>
                <td><span class="state state-excluded">excluded</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <figure class="term">
          <figcaption class="term-bar"><span class="prompt">$</span>trellis list --releasable</figcaption>
          <pre class="term-out"><code><span class="name">lat_core</span>  <span class="dim">hex</span>
<span class="name">lat_mid</span>   <span class="dim">hex</span>
<span class="name">lat_cli</span>   <span class="dim">hex</span></code></pre>
          <figcaption class="term-note">
            <code>package_a</code>, the package in <code>examples/</code>, still
            appears in <code>trellis list</code>, <code>graph</code>,{" "}
            <code>exec</code>, and tasks that do not exclude it. Only the
            configured task sets change.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ LIFECYCLE ============ -->
  <section class="lifecycle">
    <div class="shell">
      <div class="section-head">
        <h2>One binary across the lifecycle.</h2>
        <p>
          The same commands run locally and in CI. Run them from any package
          directory; trellis finds the workspace
          root by walking up to its configuration or the git repository root.
        </p>
      </div>
      <ol class="phases">
        <li class="phase">
          <h3><span class="phase-index" aria-hidden="true">1</span>Run tasks across packages</h3>
          <p>
            Build, test, and run custom tasks in dependency order. Select the
            packages affected by a change, locally or in CI.
          </p>
          <a href="/docs/task-running/">Read the task-running guide →</a>
        </li>
        <li class="phase">
          <h3><span class="phase-index" aria-hidden="true">2</span>Plan versions and changelogs</h3>
          <p>
            Record changes as TOML fragments. Review the version plan before
            applying package bumps and generated changelogs.
          </p>
          <a href="/docs/changelog/">Read the versioning guide →</a>
        </li>
        <li class="phase">
          <h3><span class="phase-index" aria-hidden="true">3</span>Automate release workflows</h3>
          <p>
            Generate GitHub Actions matrices, check changelog coverage, and open
            release pull requests from the same workspace model.
          </p>
          <a href="/docs/ci/">Read the CI recipes →</a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ DOCTOR ============ -->
  <section class="drift">
    <div class="shell drift-stack">
      <div class="section-head">
        <h2>Checks for drift.</h2>
        <p>
          <code>trellis doctor</code> checks locked versions, changelogs, tags,
          and toolchain pins against the workspace. It reports each problem
          and exits non-zero on errors; warnings do not fail the command.
        </p>
      </div>
      <figure class="term">
        <figcaption class="term-bar"><span class="prompt">$</span>trellis doctor</figcaption>
        <pre class="term-out"><code><span class="dim">checked:</span> member globs resolve and every package has a parseable gleam.toml
<span class="dim">checked:</span> path dependencies stay inside the workspace; graph is acyclic
<span class="dim">checked:</span> manifest.toml locked versions match workspace-internal gleam.toml versions
<span class="dim">checked:</span> pinned git dependency SHAs remain reachable from their tracked refs (advisory)
<span class="dim">checked:</span> each releasable package's version is not behind its CHANGELOG
<span class="dim">...</span>

warning: package `lat_core` has changelog history that trellis has not batched yet; it will be adopted on the next release
<span class="dim">...</span>
<span class="ok">ok: 4 package(s) (1 workspace, 0 git_only, 3 hex), 3 warning(s)</span></code></pre>
        <figcaption class="term-note">
          Excerpt from the example workspace.{" "}
          <code>trellis doctor --fix</code> imports its existing changelog history.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ INSTALL ============ -->
  <section class="install" id="install">
    <div class="shell">
      <div class="section-head">
        <h2>Install a prebuilt binary.</h2>
        <p>
          Install trellis without a Rust toolchain. Release archives include
          SLSA build provenance attestations. Gleam tasks still need Gleam and
          the tools required by your chosen target.
        </p>
      </div>
      <dl class="channels">
        <div class="channel">
          <dt>Shell <span class="dim-note">(Linux, macOS)</span></dt>
          <dd>
            <div class="cmdline">
              <code><span class="prompt">$</span>{installCmd}</code>
              <button class="copy-btn" type="button" aria-live="polite" data-copy={installCmd}>Copy</button>
            </div>
          </dd>
        </div>
        <div class="channel">
          <dt>Homebrew</dt>
          <dd>
            <div class="cmdline">
              <code><span class="prompt">$</span>brew install tylerbutler/tap/trellis</code>
              <button class="copy-btn" type="button" aria-live="polite" data-copy="brew install tylerbutler/tap/trellis">Copy</button>
            </div>
          </dd>
        </div>
        <div class="channel">
          <dt>mise <span class="dim-note">(pin it in mise.toml)</span></dt>
          <dd>
            <div class="cmdline">
              <code><span class="prompt">$</span>{miseCmd}</code>
              <button class="copy-btn" type="button" aria-live="polite" data-copy={miseCmd}>Copy</button>
            </div>
          </dd>
        </div>
        <div class="channel">
          <dt>From source</dt>
          <dd>
            <div class="cmdline">
              <code><span class="prompt">$</span>cargo install --git https://github.com/tylerbutler/trellis</code>
              <button class="copy-btn" type="button" aria-live="polite" data-copy="cargo install --git https://github.com/tylerbutler/trellis">Copy</button>
            </div>
          </dd>
        </div>
      </dl>
      <p class="install-coda">
        Windows installer and pinned-version URLs are on the
        <a href="https://github.com/tylerbutler/trellis/releases">releases page</a>.
        Run <code>trellis doctor</code> inside your Gleam repository to check it.
        Use <code>trellis init</code> when you want to configure workspace settings;
        the <a href="/docs/configuration/">configuration guide</a> covers what it
        writes.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ---- hero ---- */
  .hero {
    padding-block: clamp(4rem, 4rem + 4vw, 7.5rem) var(--sp-xl);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  h1 {
    font-size: var(--text-display);
    font-stretch: 118%;
    font-weight: 680;
    letter-spacing: -0.022em;
  }

  h1 em {
    display: block;
    font-style: normal;
    color: var(--brass);
  }

  .lead {
    font-size: var(--text-lead);
    color: var(--ink-soft);
    max-width: 52ch;
    margin-top: var(--sp-lg);
  }

  .lead code {
    font-size: 0.85em;
    color: var(--ink);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin-top: var(--sp-xl);
  }

  .hero-install {
    margin-top: var(--sp-md);
    max-width: 44rem;
  }

  .hero-install code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    line-height: 1.7;
  }

  .hero-term .term-note {
    padding: var(--sp-xs) var(--sp-md) var(--sp-sm);
    border-top: 1px solid var(--line-soft);
    font-size: var(--text-fine);
    color: var(--muted);
  }

  /* ---- section rhythm ---- */
  section + section {
    margin-top: var(--sp-section);
  }

  .section-head {
    max-width: var(--measure);
  }

  .section-head h2 {
    font-size: var(--text-h2);
    font-stretch: 114%;
  }

  .section-head p {
    margin-top: var(--sp-md);
    color: var(--ink-soft);
  }

  /* ---- glue ledger ---- */
  .ledger-scroll {
    margin-top: var(--sp-xl);
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .ledger {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .ledger th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    font-weight: 560;
    color: var(--muted);
    padding: var(--sp-sm) var(--sp-lg);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
    white-space: nowrap;
  }

  .ledger td {
    padding: var(--sp-md) var(--sp-lg);
    vertical-align: top;
    border-bottom: 1px solid var(--line-soft);
  }

  .ledger tbody tr:last-child td {
    border-bottom: none;
  }

  .ledger td:first-child {
    white-space: nowrap;
    color: var(--brass);
  }

  .ledger td:last-child {
    color: var(--muted);
  }

  .ledger code {
    font-size: 0.9em;
  }

  .ledger-coda {
    margin-top: var(--sp-lg);
    font-size: var(--text-lead);
    max-width: var(--measure);
  }

  /* ---- derived (committed cobalt band) ---- */
  .derived {
    background: var(--cobalt-band);
    border-block: 1px solid var(--line);
    padding-block: var(--sp-section);
  }

  .doctrine {
    max-width: 60rem;
    margin-inline: auto;
    text-align: center;
  }

  .doctrine p {
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.6rem);
    font-stretch: 116%;
    font-weight: 660;
    line-height: 1.25;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }

  .derived-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    margin-top: var(--sp-2xl);
    align-items: start;
  }

  .config {
    min-width: 0;
  }

  .derived-list h3 {
    font-size: var(--text-h3);
    margin-bottom: var(--sp-lg);
  }

  .derived-list ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-lg);
  }

  .derived-list li {
    position: relative;
    padding-left: var(--sp-lg);
  }

  .derived-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--brass);
    transform: rotate(45deg);
  }

  .derived-list strong {
    display: block;
    margin-bottom: var(--sp-2xs);
  }

  .derived-list li,
  .derived .section-head p {
    color: var(--ink-soft);
  }

  /* ---- release exclusions ---- */
  .exclusions-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .exclusions .section-head p + p {
    margin-top: var(--sp-sm);
  }

  .exclusions .section-head a {
    display: inline-block;
    margin-top: var(--sp-lg);
    font-weight: 620;
  }

  .exclusion-proof {
    display: grid;
    gap: var(--sp-lg);
    min-width: 0;
  }

  .exclusion-ledger-scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .exclusion-ledger {
    width: 100%;
    min-width: 42rem;
    border-collapse: collapse;
    font-size: var(--text-small);
  }

  .exclusion-ledger th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    font-weight: 560;
    color: var(--muted);
    padding: var(--sp-sm) var(--sp-md);
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }

  .exclusion-ledger td {
    padding: var(--sp-md);
    border-bottom: 1px solid var(--line-soft);
  }

  .exclusion-ledger tbody tr:last-child td {
    border-bottom: none;
  }

  .exclusion-ledger td:first-child {
    color: var(--brass);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .state::before {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: currentColor;
  }

  .state-included {
    color: var(--ink-soft);
  }

  .state-excluded {
    color: var(--muted);
  }

  .exclusion-proof .term-note {
    padding: var(--sp-xs) var(--sp-md) var(--sp-sm);
    border-top: 1px solid var(--line-soft);
    font-size: var(--text-fine);
    color: var(--muted);
  }

  .exclusion-proof .term-note code {
    color: var(--ink-soft);
  }

  /* ---- lifecycle ---- */
  .phases {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-2xl);
    display: grid;
    gap: var(--sp-2xl);
  }

  .phase h3 {
    display: flex;
    align-items: baseline;
    gap: var(--sp-md);
    font-size: var(--text-h3);
    padding-bottom: var(--sp-sm);
    border-bottom: 1px solid var(--line);
  }

  .phase-index {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-weight: 640;
    color: var(--brass);
  }

  .phase p {
    margin-top: var(--sp-sm);
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .phase a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: var(--sp-xs);
    font-weight: 620;
  }

  /* ---- opinionated, but modular ---- */
  .adopt-paths {
    list-style: none;
    padding: 0;
    margin-top: var(--sp-2xl);
    display: grid;
